{
  "$schema": "../../../crates/tauri-schema-generator/schemas/config.schema.json",
  "productName": "Huawei Account Test",
  "version": "1.0.0",
  "identifier": "com.richerfu.huaweiaccount",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Huawei Account Test",
        "width": 480,
        "height": 360,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "../../.icons/32x32.png",
      "../../.icons/128x128.png",
      "../../.icons/128x128@2x.png",
      "../../.icons/icon.ico"
    ],
    "openHarmony": {
      "deviceTypes": {
        "mobile": ["phone", "tablet"],
        "desktop": ["2in1"]
      }
    }
  }
}
